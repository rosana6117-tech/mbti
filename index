const TT={화력:'채팅방 발전소',텐션:'ㅋㅋ 무한동력',공감:'리액션 장인',진지:'장문 철학자',짤력:'짤 수집가',인싸력:'멘션 자석'};
const ADJ={화력:'쉴 틈 없는',텐션:'하이텐션',공감:'다정한',진지:'진지한',짤력:'비주얼파',인싸력:'마당발'};
function arch(u){const o=u.hex.map((v,i)=>[v,AX[i]]).slice(1).sort((a,b)=>b[0]-a[0]);
  if(u.hex[0]<45&&o[0][0]<70)return (o[0][0]>=60?ADJ[o[0][1]]+' ':'')+'조용한 관찰자';
  const adj=u.hex[0]>=85?ADJ['화력']:ADJ[o[1][1]];return adj+' '+TT[o[0][1]]}
const slot=h=>h<5?'새벽':h<9?'이른 아침':h<12?'오전':h<14?'점심':h<18?'오후':h<21?'저녁':'밤';
function persona(u){
  const s=[];
  s.push(`${slot(u.peak)} ${u.peak}시에 가장 활발한 편`);
  if(u.n>=300&&u.night>.1)s.push('심야에도 자주 출몰');
  else if(u.n>=300&&u.morning>.2)s.push('아침 대화를 여는 편');
  s.push(u.avglen>=12?`한 번에 평균 ${u.avglen}자로 길게 씀`:u.avglen<=6?`평균 ${u.avglen}자의 짧고 빠른 티키타카형`:`평균 ${u.avglen}자 길이로 말함`);
  if(u.best[0])s.push(`가장 많이 주고받는 상대는 ${U[u.best[0][0]].name}`);
  return s.join(' · ')+'.';
}
function hexSvg(u){
  const R=70,cx=0,cy=0,pt=(i,r)=>{const a=-Math.PI/2+i*Math.PI/3;return[cx+r*Math.cos(a),cy+r*Math.sin(a)]};
  let g='';[25,50,75,100].forEach(p=>{g+=`<polygon points="${[0,1,2,3,4,5].map(i=>pt(i,R*p/100).join(',')).join(' ')}" fill="none" stroke="var(--line)"/>`});
  [0,1,2,3,4,5].forEach(i=>{const[a,b]=pt(i,R);g+=`<line x1="0" y1="0" x2="${a}" y2="${b}" stroke="var(--line)"/>`});
  const poly=u.hex.map((v,i)=>pt(i,R*v/100).join(',')).join(' ');
  let lb='';AX.forEach((a,i)=>{const[x,y]=pt(i,R+18);const anc=Math.abs(x)<5?'middle':x>0?'start':'end';
    lb+=`<text x="${x}" y="${y-2}" text-anchor="${anc}">${a}</text><text class="vv" x="${x}" y="${y+10}" text-anchor="${anc}">${u.hex[i]}</text>`});
  return `<svg class="hex" viewBox="-118 -104 236 206" role="img" aria-label="${u.name} 육각형 스탯">${g}<polygon points="${poly}" fill="${col(u.t)}" fill-opacity=".28" stroke="${col(u.t)}" stroke-width="2"/>${u.hex.map((v,i)=>{const[x,y]=pt(i,R*v/100);return`<circle cx="${x}" cy="${y}" r="2.6" fill="${col(u.t)}"/>`}).join('')}${lb}</svg>`;
}
function card(u){
  const b=(award[u.i]||[]).filter(x=>!/[23]위$/.test(x)).concat((award[u.i]||[]).filter(x=>/[23]위$/.test(x))).slice(0,4);
  return `<article class="card"><div class="card-top bg-${u.t}"><span class="nm">${u.name}</span><span class="rk">#${u.rank}</span>
  <span class="mb">${u.mbti} · ${u.sex} ${u.age}</span><span class="rk">${fmt(u.n)}건</span><span class="arch">${arch(u)}</span></div>
  <div class="card-body">${hexSvg(u)}
  <div class="mini"><div><div class="l">일평균</div><div class="v">${u.perday}</div></div><div><div class="l">출석</div><div class="v">${u.days}일</div></div><div><div class="l">피크</div><div class="v">${u.peak}시</div></div><div><div class="l">평균 글자</div><div class="v">${u.avglen}</div></div></div>
  <p class="desc">${persona(u)}</p>
  <dl class="kv"><dt>키워드</dt><dd>${u.words.length?u.words.map(w=>`<span class="pill">${w}</span>`).join(''):'<span class="note">표본 부족</span>'}</dd>
  <dt>말버릇</dt><dd>${u.habit.length?u.habit.map(w=>`<span class="pill">${w}</span>`).join(''):'<span class="note">표본 부족</span>'}</dd>
  <dt>베프</dt><dd>${u.best.map(([j])=>who(U[j])).join('')||'-'}</dd></dl>
  ${b.length?`<div class="badges">${b.map(x=>`<span class="badge">${x}</span>`).join('')}</div>`:''}
  </div></article>`;
}
let tf='ALL';
$('#tempChips').innerHTML=[['ALL','전체'],['NT','NT'],['NF','NF'],['SJ','SJ'],['SP','SP']].map(([k,l])=>`<button class="chip" id="tc-${k}" data-k="${k}" aria-pressed="${k==='ALL'}">${l}</button>`).join('');
$('#tempChips').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;tf=b.dataset.k;document.querySelectorAll('#tempChips .chip').forEach(c=>c.setAttribute('aria-pressed',c===b));renderCards()});
$('#q').addEventListener('input',renderCards);$('#sort').addEventListener('change',renderCards);
function renderCards(){
  const q=$('#q').value.trim().toUpperCase(),s=$('#sort').value;
  let L=U.filter(u=>(tf==='ALL'||u.t===tf)&&(!q||u.name.includes(q)||u.mbti.includes(q)||u.name.toUpperCase().includes(q)));
  L.sort((a,b)=>s==='mbti'?a.mbti.localeCompare(b.mbti)||b.n-a.n:b[s]-a[s]);
  $('#cards').innerHTML=L.length?L.map(card).join(''):'<div class="empty">조건에 맞는 멤버 없음</div>';
}
renderCards();

/* ---------- page 3 ---------- */
const verdict=s=>s>=85?'영혼의 단짝':s>=75?'찰떡 티키타카':s>=65?'알고 보면 잘 맞음':s>=55?'무난한 사이':s>=45?'아직 탐색 중':'평행선 관계';
function side(i){
  const u=U[i];
  const L=U.filter(v=>v.i!==i).map(v=>[v,C(i,v.i)]).sort((a,b)=>b[1][0]-a[1][0]);
  const T=U.filter(v=>v.i!==i).map(v=>[v,C(i,v.i)[5]]).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const li=(x,v)=>`<li data-j="${x.i}">${who(x)}<span class="sc">${v}</span></li>`;
  $('#side').innerHTML=`<div class="eyebrow">선택한 멤버</div><h3>${u.name} <span class="tag t-${u.t}">${u.mbti}</span></h3><p class="note" style="margin:4px 0 14px">${arch(u)} · ${fmt(u.n)}건</p>
  <div style="display:grid;gap:16px">
  <div><h2 style="font-size:16px">궁합 TOP 5</h2><ul class="lst">${L.slice(0,5).map(([v,c])=>li(v,c[0]+'점')).join('')}</ul></div>
  <div><h2 style="font-size:16px">대화량 TOP 5</h2><ul class="lst">${T.map(([v,c])=>li(v,fmt(c))).join('')}</ul></div>
  <div><h2 style="font-size:16px">상극 3</h2><ul class="lst">${L.slice(-3).reverse().map(([v,c])=>li(v,c[0]+'점')).join('')}</ul></div></div>`;
  $('#side').querySelectorAll('li').forEach(el=>el.addEventListener('click',()=>{setPair(i,+el.dataset.j)}));
}
function setPair(a,b){$('#ca').value=a;$('#cb').value=b;calc();$('#ca').scrollIntoView({behavior:'smooth',block:'center'})}
const opts=U.map(u=>`<option value="${u.i}">${u.name} · ${u.mbti}</option>`).join('');
$('#ca').innerHTML=opts;$('#cb').innerHTML=opts;$('#ca').value=0;$('#cb').value=1;
$('#ca').addEventListener('change',calc);$('#cb').addEventListener('change',calc);
function calc(){
  const a=+$('#ca').value,b=+$('#cb').value;
  if(a===b){$('#calcOut').innerHTML='<p class="note" style="margin-top:14px">서로 다른 두 명을 골라야 함.</p>';return}
  const c=C(a,b),A=U[a],B=U[b];
  const parts=[['대화 케미',c[1]],['생활 리듬',c[2]],['MBTI 궁합',c[3]],['말투 싱크',c[4]]];
  const best=parts.slice().sort((x,y)=>y[1]-x[1])[0][0];
  $('#calcOut').innerHTML=`<div class="score"><span class="big">${c[0]}</span><span class="verdict">${verdict(c[0])}</span></div>
  <p class="note">${A.name}·${B.name} 사이 2분 내 주고받은 대화+멘션 <b class="num">${fmt(c[5])}</b>회 · 가장 강한 연결고리는 <b>${best}</b></p>
  <div class="brk">${parts.map(([l,v])=>`<div class="r"><span>${l}</span><span class="b"><i style="width:${v}%"></i></span><span class="num">${v}</span></div>`).join('')}</div>`;
}
calc();
(function(){const P=[];for(let i=0;i<N;i++)for(let j=i+1;j<N;j++)P.push([i,j,C(i,j)]);
  P.sort((a,b)=>b[2][0]-a[2][0]);
  $('#bestPairs').innerHTML=P.slice(0,10).map(([i,j,c])=>`<li data-a="${i}" data-b="${j}"><span class="pr">${who(U[i])}<span class="note">×</span>${who(U[j])}</span><span class="num" style="font-weight:700">${c[0]}점</span></li>`).join('');
  $('#bestPairs').querySelectorAll('li').forEach(el=>el.addEventListener('click',()=>setPair(+el.dataset.a,+el.dataset.b)));
})();
(function(){
  let h=`<div class="h"></div>`+U.map(u=>`<div class="h v">${u.name}</div>`).join('');
  const all=[];for(let i=0;i<N;i++)for(let j=i+1;j<N;j++)all.push(C(i,j)[0]);
  const mn=Math.min(...all),mx=Math.max(...all);
  U.forEach(a=>{h+=`<div class="h">${a.name}</div>`;U.forEach(b=>{if(a.i===b.i){h+=`<div style="background:var(--line);cursor:default"></div>`;return}
    const s=C(a.i,b.i)[0],p=Math.round(Math.pow((s-mn)/(mx-mn),1.4)*100);
    h+=`<div data-a="${a.i}" data-b="${b.i}" title="${a.name} × ${b.name} · ${s}점" style="background:color-mix(in srgb,var(--heat1) ${p}%,var(--heat0))"></div>`})});
  const m=$('#matrix');m.style.gridTemplateColumns=`auto repeat(${N},16px)`;m.innerHTML=h;
  m.addEventListener('click',e=>{const d=e.target.closest('[data-a]');if(d)setPair(+d.dataset.a,+d.dataset.b)});
})();
side(0);
function drawNet(){
  if(typeof d3==='undefined'){$('#net').outerHTML='<p class="empty">관계도 라이브러리를 불러오지 못함. 인터넷 연결 확인 필요.</p>';return}
  const svg=d3.select('#net');const el=svg.node();
  const W=el.clientWidth||700,H=el.clientHeight||560;svg.attr('viewBox',`0 0 ${W} ${H}`);
  const nodes=U.map(u=>({id:u.i,u}));
  const E=new Map();
  U.forEach(u=>{const L=U.filter(v=>v.i!==u.i).map(v=>[v.i,C(u.i,v.i)]).sort((a,b)=>b[1][5]-a[1][5]).slice(0,3);
    L.forEach(([j,c])=>{const k=Math.min(u.i,j)+'-'+Math.max(u.i,j);if(c[5]>0)E.set(k,{source:u.i,target:j,w:c[5]})})});
  for(let i=0;i<N;i++)for(let j=i+1;j<N;j++){const c=C(i,j);if(c[5]>=600)E.set(i+'-'+j,{source:i,target:j,w:c[5]})}
  const links=[...E.values()],wmax=d3.max(links,l=>l.w);
  const r=d3.scaleSqrt().domain([0,d3.max(U,u=>u.n)]).range([4,26]);
  const sim=d3.forceSimulation(nodes).force('link',d3.forceLink(links).id(d=>d.id).distance(l=>170-100*Math.sqrt(l.w/wmax)).strength(.3))
    .force('charge',d3.forceManyBody().strength(-380)).force('center',d3.forceCenter(W/2,H/2))
    .force('collide',d3.forceCollide(d=>r(d.u.n)+4)).force('x',d3.forceX(W/2).strength(.03)).force('y',d3.forceY(H/2).strength(.05));
  const lk=svg.append('g').selectAll('line').data(links).join('line').attr('stroke','var(--mute)').attr('stroke-opacity',l=>.15+.55*l.w/wmax).attr('stroke-width',l=>.6+5*Math.sqrt(l.w/wmax));
  const nd=svg.append('g').selectAll('g').data(nodes).join('g').style('cursor','pointer');
  nd.append('circle').attr('r',d=>r(d.u.n)).attr('fill',d=>col(d.u.t)).attr('stroke','var(--panel)').attr('stroke-width',2);
  nd.append('text').attr('text-anchor','middle').attr('dy',d=>r(d.u.n)+12).text(d=>d.u.name);
  nd.append('title').text(d=>`${d.u.name} ${d.u.mbti} · ${d.u.n}건`);
  let sel=0;
  function hi(i){sel=i;const nb=new Set([i]);links.forEach(l=>{if(l.source.id===i)nb.add(l.target.id);if(l.target.id===i)nb.add(l.source.id)});
    nd.attr('opacity',d=>nb.has(d.id)?1:.25);lk.attr('stroke',l=>l.source.id===i||l.target.id===i?'var(--accent)':'var(--mute)').attr('stroke-opacity',l=>l.source.id===i||l.target.id===i?.9:.08);
    nd.select('circle').attr('stroke',d=>d.id===i?'var(--ink)':'var(--panel)').attr('stroke-width',d=>d.id===i?3:2)}
  nd.on('click',(e,d)=>{hi(d.id);side(d.id)});
  nd.call(d3.drag().on('start',(e,d)=>{if(!e.active)sim.alphaTarget(.2).restart();d.fx=d.x;d.fy=d.y}).on('drag',(e,d)=>{d.fx=e.x;d.fy=e.y}).on('end',(e,d)=>{if(!e.active)sim.alphaTarget(0);d.fx=null;d.fy=null}));
  sim.on('tick',()=>{nodes.forEach(d=>{const rr=r(d.u.n)+2;d.x=Math.max(rr,Math.min(W-rr,d.x));d.y=Math.max(rr,Math.min(H-rr-12,d.y))});
    lk.attr('x1',l=>l.source.x).attr('y1',l=>l.source.y).attr('x2',l=>l.target.x).attr('y2',l=>l.target.y);nd.attr('transform',d=>`translate(${d.x},${d.y})`)});
  hi(0);
}
/* init tab */
let start=(location.hash||'').slice(1);
if(!['rank','cards','chem'].includes(start)){try{start=localStorage.getItem('mbtiTab')||'rank'}catch(e){start='rank'}}
if(!['rank','cards','chem'].includes(start))start='rank';
show(start);
})();
</script>
