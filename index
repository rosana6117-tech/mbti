<title>과몰입 반말방 리포트</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=IBM+Plex+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
/* Layout: 고정 GNB + 3개 화면 전환. 각 화면은 1120px 컬럼, 섹션은 얇은 패널로 구분. MBTI 기질 4색이 전체 색 체계의 축 */
:root{
  --bg:#EEF0F5; --panel:#FFFFFF; --ink:#1C1E2B; --mute:#666B80; --line:#D9DCE6; --soft:#F5F6FA;
  --accent:#E8435F; --accent-ink:#FFFFFF;
  --nt:#7A5BB0; --nf:#2F9468; --sj:#3576B0; --sp:#C99412;
  --heat0:#F1F2F7; --heat1:#E8435F;
  --f-display:"Black Han Sans","IBM Plex Sans KR",system-ui,sans-serif;
  --f-body:"IBM Plex Sans KR",system-ui,-apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --f-num:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  --gnb-h:58px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#14151D; --panel:#1D1F2A; --ink:#ECEDF3; --mute:#9DA1B5; --line:#2E3140; --soft:#242735;
  --accent:#FF6380; --accent-ink:#14151D;
  --nt:#A587DB; --nf:#53C392; --sj:#64A3DC; --sp:#E9B93E; --heat0:#232634; --heat1:#FF6380; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#14151D; --panel:#1D1F2A; --ink:#ECEDF3; --mute:#9DA1B5; --line:#2E3140; --soft:#242735;
  --accent:#FF6380; --accent-ink:#14151D;
  --nt:#A587DB; --nf:#53C392; --sj:#64A3DC; --sp:#E9B93E; --heat0:#232634; --heat1:#FF6380; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:14px;line-height:1.55}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--ink)}
.gnb{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:50;background:var(--ink);color:var(--bg);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.gnb-in{max-width:1120px;margin:0 auto;height:var(--gnb-h);display:flex;align-items:center;gap:20px}
.brand{font-family:var(--f-display);font-size:19px;letter-spacing:.5px;white-space:nowrap}
.brand b{color:var(--accent);font-weight:400}
.tabs{display:flex;gap:4px;margin-left:auto}
.tab{appearance:none;border:0;background:transparent;color:inherit;opacity:.65;font:500 14px var(--f-body);padding:8px 14px;border-radius:999px;cursor:pointer;white-space:nowrap}
.tab:hover{opacity:1}
.tab[aria-selected="true"]{opacity:1;background:var(--accent);color:var(--accent-ink);font-weight:700}
.tab:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
main{padding-top:calc(var(--gnb-h) + 24px);padding-bottom:64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.page{max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:20px}
.head h1{font-family:var(--f-display);font-weight:400;font-size:clamp(28px,5vw,44px);line-height:1.1;margin:0;text-wrap:balance}
.head p{margin:6px 0 0;color:var(--mute)}
.eyebrow{font:700 11px var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}
.panel h2{font-family:var(--f-display);font-weight:400;font-size:21px;margin:0 0 4px}
.panel .sub{color:var(--mute);font-size:12.5px;margin:0 0 14px}
.num{font-family:var(--f-num);font-variant-numeric:tabular-nums}
.grid2{display:grid;grid-template-columns:1.25fr 1fr;gap:20px}
@media (max-width:860px){.grid2{grid-template-columns:1fr}}
/* KPI */
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.kpi{background:var(--panel);padding:16px 18px}
.kpi .l{font-size:12px;color:var(--mute)}
.kpi .v{font-family:var(--f-num);font-size:24px;font-weight:700;margin-top:2px}
.kpi .s{font-size:12px;color:var(--mute)}
@media (max-width:860px){.kpis{grid-template-columns:repeat(2,1fr)}.kpi:last-child{grid-column:1/-1}}
/* podium */
.podium{display:grid;grid-template-columns:1fr 1.15fr 1fr;align-items:end;gap:12px;margin-bottom:18px}
.pod{border-radius:12px;padding:14px 12px;text-align:center;background:var(--soft);border:1px solid var(--line)}
.pod .r{font-family:var(--f-display);font-size:30px;color:var(--accent)}
.pod .nm{font-family:var(--f-display);font-size:22px}
.pod .v{font-family:var(--f-num);font-weight:700}
.pod.p1{padding-block:24px;border-color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.chip{appearance:none;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:500 12.5px var(--f-body);padding:5px 11px;border-radius:999px;cursor:pointer}
.chip:hover{border-color:var(--mute)}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.board{display:flex;flex-direction:column;gap:3px;max-height:620px;overflow:auto;padding-right:4px}
.row{display:grid;grid-template-columns:30px 118px 1fr 76px;gap:10px;align-items:center;font-size:13px;padding:3px 0}
.row .rk{font-family:var(--f-num);color:var(--mute);text-align:right}
.row .bar{height:12px;border-radius:3px;background:var(--soft);overflow:hidden}
.row .bar i{display:block;height:100%;border-radius:3px}
.row .val{font-family:var(--f-num);text-align:right;font-weight:700}
.who{display:flex;align-items:center;gap:6px;min-width:0;white-space:nowrap}
.who b{font-weight:700}
.tag{font:700 10.5px var(--f-num);padding:1px 6px;border-radius:5px;color:#fff;letter-spacing:.02em}
.t-NT{background:var(--nt)}.t-NF{background:var(--nf)}.t-SJ{background:var(--sj)}.t-SP{background:var(--sp)}
:root .tag{color:var(--panel)}
.awards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}
.aw{border:1px solid var(--line);border-radius:12px;padding:12px 14px;background:var(--soft);display:flex;flex-direction:column;gap:2px}
.aw .t{font-size:12px;color:var(--mute)}
.aw .n{font-family:var(--f-display);font-size:20px}
.aw .d{font-size:12.5px}
.aw .d .num{font-weight:700}
.chart{width:100%;height:auto;display:block}
.chart text{fill:var(--mute);font:11px var(--f-num)}
.heat{display:grid;grid-template-columns:28px repeat(24,minmax(14px,1fr));gap:2px;min-width:480px}
.heat div{aspect-ratio:1;border-radius:3px}
.heat .lb{aspect-ratio:auto;font:11px var(--f-num);color:var(--mute);display:flex;align-items:center;justify-content:center}
.scroll{overflow-x:auto}
.cloud{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:baseline}
.cloud span{font-family:var(--f-display);line-height:1.1}
.cloud small{font:11px var(--f-num);color:var(--mute);margin-left:3px}
/* cards */
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.toolbar input,.toolbar select,.calc select{font:14px var(--f-body);padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--ink)}
.toolbar .chips{margin:0}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column}
.card-top{padding:14px 16px 12px;color:var(--panel);display:grid;grid-template-columns:1fr auto;gap:2px 10px}
.card-top .nm{font-family:var(--f-display);font-size:28px;line-height:1}
.card-top .rk{font-family:var(--f-num);font-weight:700;font-size:13px;opacity:.9;text-align:right}
.card-top .mb{font-family:var(--f-num);font-weight:700;font-size:13px;letter-spacing:.05em}
.card-top .arch{grid-column:1/-1;font-weight:700;font-size:14px;margin-top:6px}
.bg-NT{background:var(--nt)}.bg-NF{background:var(--nf)}.bg-SJ{background:var(--sj)}.bg-SP{background:var(--sp)}
.card-body{padding:12px 16px 16px;display:flex;flex-direction:column;gap:12px;flex:1}
.hex{width:100%;max-width:260px;margin:0 auto;display:block}
.hex text{font:500 11px var(--f-body);fill:var(--mute)}
.hex .vv{font:700 10px var(--f-num);fill:var(--ink)}
.mini{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border-radius:10px;overflow:hidden}
.mini div{background:var(--soft);padding:7px 4px;text-align:center}
.mini .l{font-size:10.5px;color:var(--mute)}
.mini .v{font-family:var(--f-num);font-weight:700;font-size:13.5px}
.desc{font-size:13px;margin:0}
.kv{display:grid;grid-template-columns:52px 1fr;gap:6px 8px;font-size:12.5px;align-items:start}
.kv dt{color:var(--mute)}
.kv dd{margin:0;display:flex;flex-wrap:wrap;gap:4px;min-width:0}
.pill{background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:0 6px;font-size:12px}
.badges{display:flex;flex-wrap:wrap;gap:4px;margin-top:auto}
.badge{font-size:11px;font-weight:700;border:1px solid var(--accent);color:var(--accent);border-radius:999px;padding:1px 8px}
.empty{color:var(--mute);padding:30px;text-align:center}
/* chem */
.netwrap{position:relative;border-radius:12px;background:var(--soft);overflow:hidden}
#net{width:100%;height:560px;display:block;touch-action:none}
#net text{font:700 11px var(--f-body);fill:var(--ink);pointer-events:none;paint-order:stroke;stroke:var(--soft);stroke-width:3px}
.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--mute);margin-top:10px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.side h3{font-family:var(--f-display);font-weight:400;font-size:22px;margin:0}
.lst{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
.lst li{display:grid;grid-template-columns:1fr 54px;gap:8px;align-items:center;font-size:13px;padding:5px 8px;border-radius:8px;background:var(--soft);cursor:pointer}
.lst li:hover{outline:1px solid var(--line)}
.lst .sc{font-family:var(--f-num);font-weight:700;text-align:right}
.calc{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}
.calc .x{font-family:var(--f-display);font-size:22px;color:var(--accent)}
.score{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin:16px 0 6px}
.score .big{font-family:var(--f-num);font-size:56px;font-weight:700;line-height:1;color:var(--accent)}
.score .verdict{font-family:var(--f-display);font-size:22px}
.brk{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.brk .r{display:grid;grid-template-columns:84px 1fr 40px;gap:10px;align-items:center;font-size:12.5px}
.brk .b{height:8px;background:var(--soft);border-radius:4px;overflow:hidden}
.brk .b i{display:block;height:100%;background:var(--ink)}
.matrix{display:grid;gap:1px;min-width:max-content}
.matrix div{width:16px;height:16px;border-radius:2px;cursor:pointer}
.matrix .h{font:10px var(--f-body);color:var(--mute);cursor:default;display:flex;align-items:center;justify-content:flex-end;padding-right:4px;width:auto;white-space:nowrap}
.matrix .v{writing-mode:vertical-rl;justify-content:flex-start;height:40px;padding:0 0 4px}
.toplist{counter-reset:t;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.toplist li{display:grid;grid-template-columns:26px 1fr auto;gap:8px;align-items:center;padding:7px 10px;border-radius:10px;background:var(--soft);font-size:13px;cursor:pointer}
.toplist li::before{counter-increment:t;content:counter(t);font-family:var(--f-num);font-weight:700;color:var(--accent)}
.toplist .pr{display:flex;align-items:center;gap:6px;flex-wrap:wrap;min-width:0}
.note{font-size:12px;color:var(--mute);margin:0}
@media (max-width:560px){
  .brand span{display:none}.gnb-in{gap:8px}.tab{padding:7px 10px;font-size:13px}
  .row{grid-template-columns:24px 100px 1fr 62px;gap:6px}
  #net{height:440px}.score .big{font-size:44px}
  .calc{grid-template-columns:1fr}.calc .x{text-align:center}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>

<nav class="gnb" aria-label="페이지 전환">
  <div class="gnb-in">
    <div class="brand">과몰입 <b>반말방</b> <span>리포트</span></div>
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" id="tab-rank" data-p="rank" aria-selected="true">채팅 랭킹</button>
      <button class="tab" role="tab" id="tab-cards" data-p="cards" aria-selected="false">캐릭터 카드</button>
      <button class="tab" role="tab" id="tab-chem" data-p="chem" aria-selected="false">관계·궁합</button>
    </div>
  </div>
</nav>

<main>
<!-- PAGE 1 -->
<section class="page" id="p-rank" role="tabpanel" aria-labelledby="tab-rank">
  <div class="head">
    <div class="eyebrow">2030 MBTI 과몰입 반말방 · 채팅 랭킹</div>
    <h1>누가 이 방을 굴리고 있나</h1>
    <p id="period"></p>
  </div>
  <div class="kpis" id="kpis"></div>
  <div class="grid2">
    <div class="panel">
      <h2>부문별 리더보드</h2>
      <p class="sub" id="boardSub">부문을 고르면 순위가 바뀜. 비율 지표는 300건 이상 멤버만 집계.</p>
      <div class="chips" id="metricChips"></div>
      <div class="podium" id="podium"></div>
      <div class="board" id="board"></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
      <div class="panel">
        <h2>반말방 어워즈</h2>
        <p class="sub">부문별 1위</p>
        <div class="awards" id="awards"></div>
      </div>
    </div>
  </div>
  <div class="panel">
    <h2>일별 메시지 추이</h2>
    <p class="sub" id="dailySub"></p>
    <div id="dailyChart"></div>
  </div>
  <div class="grid2">
    <div class="panel">
      <h2>요일 × 시간대 히트맵</h2>
      <p class="sub">색이 진할수록 메시지가 많음</p>
      <div class="scroll"><div class="heat" id="heat"></div></div>
    </div>
    <div class="panel">
      <h2>이 방의 키워드</h2>
      <p class="sub">전체 대화 명사 빈도 상위 (멤버 닉네임 제외)</p>
      <div class="cloud" id="cloud"></div>
    </div>
  </div>
</section>

<!-- PAGE 2 -->
<section class="page" id="p-cards" role="tabpanel" aria-labelledby="tab-cards" hidden>
  <div class="head">
    <div class="eyebrow">캐릭터 카드</div>
    <h1>41인의 캐릭터 도감</h1>
    <p>육각형 스탯은 멤버 41명 사이의 상대 순위(20~100). 메시지 200건 미만 멤버는 표본이 작아 중간값 쪽으로 보정됨.</p>
  </div>
  <div class="panel" style="padding:14px 16px">
    <div class="toolbar">
      <input id="q" type="search" placeholder="닉네임·MBTI 검색" aria-label="닉네임 또는 MBTI 검색">
      <div class="chips" id="tempChips"></div>
      <select id="sort" aria-label="정렬">
        <option value="n">메시지 많은 순</option>
        <option value="perday">일평균 순</option>
        <option value="hexsum">스탯 합계 순</option>
        <option value="mbti">MBTI 순</option>
      </select>
    </div>
  </div>
  <div class="panel" style="padding:14px 16px">
    <p class="note"><b>스탯 기준</b> · 화력: 총 메시지량 · 텐션: ㅋㅋ·느낌표 사용률 · 공감: ㅇㅈ/ㄹㅇ/헐/ㅠ 등 리액션 비율 · 진지: 평균 글자 수 · 짤력: 이모티콘·사진 비율 · 인싸력: 대화 상대 다양성 + 멘션 받은 수</p>
  </div>
  <div class="cards" id="cards"></div>
</section>

<!-- PAGE 3 -->
<section class="page" id="p-chem" role="tabpanel" aria-labelledby="tab-chem" hidden>
  <div class="head">
    <div class="eyebrow">관계도 · 궁합도</div>
    <h1>누구랑 제일 잘 맞나</h1>
    <p>선은 2분 이내 주고받은 대화와 멘션으로 계산. 노드를 누르면 그 사람 기준 궁합 순위가 나옴.</p>
  </div>
  <div class="grid2">
    <div class="panel">
      <h2>관계도</h2>
      <p class="sub">원 크기 = 메시지량 · 선 굵기 = 대화 밀도 · 드래그로 이동</p>
      <div class="netwrap"><svg id="net" role="img" aria-label="멤버 관계 네트워크"></svg></div>
      <div class="legend"><span><i style="background:var(--nt)"></i>NT 분석가</span><span><i style="background:var(--nf)"></i>NF 외교관</span><span><i style="background:var(--sj)"></i>SJ 관리자</span><span><i style="background:var(--sp)"></i>SP 탐험가</span></div>
    </div>
    <div class="panel side" id="side"></div>
  </div>
  <div class="grid2">
    <div class="panel">
      <h2>궁합 계산기</h2>
      <p class="sub">대화 케미 45% · 생활 리듬 20% · MBTI 궁합 20% · 말투 싱크 15%</p>
      <div class="calc">
        <select id="ca" aria-label="첫 번째 멤버"></select>
        <div class="x">×</div>
        <select id="cb" aria-label="두 번째 멤버"></select>
      </div>
      <div id="calcOut"></div>
    </div>
    <div class="panel">
      <h2>베스트 케미 TOP 10</h2>
      <p class="sub">궁합 점수 기준 · 누르면 계산기에 반영</p>
      <ol class="toplist" id="bestPairs"></ol>
    </div>
  </div>
  <div class="panel">
    <h2>궁합 매트릭스</h2>
    <p class="sub">메시지 많은 순 정렬 · 칸을 누르면 계산기에 반영 · 진할수록 궁합 높음</p>
    <div class="scroll"><div class="matrix" id="matrix"></div></div>
  </div>
</section>
